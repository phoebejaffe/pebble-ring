# Local emulator secret used by the webhook handler.
WEBHOOK_AUTH_TOKEN=replace-with-a-local-token

# Optional. Defaults to authorization.
WEBHOOK_AUTH_HEADER=authorization

# Pebble sends a timestamp but not the phone's timezone.
NOTES_TIME_ZONE=America/Los_Angeles
NOTES_ROLLOVER_HOUR=4

# Optional. Overrides the base URL used for 💡 recording links in notes.
# Defaults to https://us-central1-PROJECT_ID.cloudfunctions.net/recordingAudio
# RECORDING_LINK_BASE_URL=https://us-central1-PROJECT_ID.cloudfunctions.net/recordingAudio
