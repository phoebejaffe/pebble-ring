# Frontend Firebase config for the Firebase project that owns the receiver.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=

# HTTPS base URL for the deployed eventsApi/eventAudioUrl Functions.
VITE_API_BASE_URL=

# The webhook token is configured with Firebase Secret Manager, not in this file:
# firebase functions:secrets:set WEBHOOK_AUTH_TOKEN
